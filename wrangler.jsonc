// Cloudflare Workers config for Founder OS (Next.js via @opennextjs/cloudflare)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "founder-os",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Run next to Supabase (Mumbai, ap-south-1) instead of wherever the visitor's request lands.
  // Keeps database round-trips fast and keeps Anthropic API calls coming from a supported region.
  "placement": { "region": "aws:ap-south-1" },
  "observability": { "enabled": true }
}
