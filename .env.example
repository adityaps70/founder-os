# Supabase — Project Settings → API Keys (the publishable key is safe in the browser; RLS protects data)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# "/founder-os" when served from https://<user>.github.io/founder-os/, empty for local dev or a custom domain
NEXT_PUBLIC_BASE_PATH=

# Time zone for "today", weeks and timestamps
NEXT_PUBLIC_APP_TIMEZONE=Asia/Kolkata

# The AI Copilot and plan changes run in the Supabase Edge Function `founder-api`.
# Set its secrets in Supabase → Edge Functions → Secrets: ANTHROPIC_API_KEY (required), ANTHROPIC_MODEL (optional).
