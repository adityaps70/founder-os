# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Used by the billing stub and invitation emails. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the app (used in auth redirects and invite links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Time zone for "today", weeks and timestamps (servers run in UTC)
NEXT_PUBLIC_APP_TIMEZONE=Asia/Kolkata

# AI Copilot — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# Billing: "stub" switches plans instantly with no payment (dev/testing).
# Add "razorpay" or "stripe" by implementing src/lib/billing/provider.ts.
BILLING_PROVIDER=stub
